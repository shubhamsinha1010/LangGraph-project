# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Override to use a different base URL (Ollama, Azure, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# ── Checkpointing ─────────────────────────────────────────────────────────────
# "memory" for local dev, "postgres" for production
CHECKPOINT_BACKEND=memory
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/incident_commander

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=change-me-in-production

# ── LangSmith (optional, turn on for tracing) ─────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=incident-commander

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_INVESTIGATION_CYCLES=5
ROLLBACK_ENABLED=true
